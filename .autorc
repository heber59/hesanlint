name: CI & Auto Release

on:
  pull_request:
    branches:
      - main
    paths:
      - "**/*.js"
      - "**/*.jsx"
      - "**/*.ts"
      - "**/*.tsx"
      - "package.json"
  push:
    branches:
      - main

jobs:
  # ─────────────────────────────────────────────
  # 1. BUILD — bundle hesanlint so npx works
  #    This is the fix for ERR_MODULE_NOT_FOUND.
  #    esbuild inlines commander + all deps into
  #    a single bin/hesanlint.js — no node_modules
  #    needed at runtime.
  # ─────────────────────────────────────────────
  build:
    name: Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Install dependencies
        run: npm install

      - name: Bundle with esbuild
        # Produces a self-contained bin/hesanlint.js
        # All deps (commander, chalk, etc.) are inlined.
        run: |
          npx esbuild src/cli.js \
            --bundle \
            --platform=node \
            --target=node18 \
            --format=esm \
            --outfile=bin/hesanlint.js

      - name: Upload bundle artifact
        uses: actions/upload-artifact@v4
        with:
          name: hesanlint-bundle
          path: bin/hesanlint.js

  # ─────────────────────────────────────────────
  # 2. LINT — run hesanlint against ./src
  #    Uses the bundle from the build step so
  #    there are no missing-dep surprises.
  # ─────────────────────────────────────────────
  lint:
    name: Performance Lint
    runs-on: ubuntu-latest
    needs: build
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Download bundle
        uses: actions/download-artifact@v4
        with:
          name: hesanlint-bundle
          path: bin

      - name: Run hesanlint
        run: node bin/hesanlint.js ./src --ci --score

  # ─────────────────────────────────────────────
  # 3. TEST
  # ─────────────────────────────────────────────
  test:
    name: Tests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Install dependencies
        run: npm install

      - name: Run tests
        run: npm test

  # ─────────────────────────────────────────────
  # 4. AUTO RELEASE — only on push to main
  #    Uses `auto shipit` which:
  #      • reads PR labels (major/minor/patch)
  #      • bumps package.json version
  #      • commits + creates a git tag
  #      • creates a GitHub Release
  #      • runs npm publish
  #
  #    Required setup (one-time):
  #      1. npx auto create-labels  (needs GH_TOKEN)
  #      2. Add .autorc to repo root (see below)
  #      3. Add GH_TOKEN + NPM_TOKEN to repo secrets
  # ─────────────────────────────────────────────
  autorelease:
    name: Auto Release
    runs-on: ubuntu-latest
    needs: [build, test]
    if: |
      github.event_name == 'push' &&
      !contains(github.event.head_commit.message, 'ci skip') &&
      !contains(github.event.head_commit.message, 'skip ci')
    steps:
      - uses: actions/checkout@v4
        with:
          token: ${{ secrets.GH_TOKEN }}
          fetch-depth: 0 # required: auto needs full git history to find last tag

      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          registry-url: "https://registry.npmjs.org/"

      - name: Configure Git
        run: |
          git config --global user.email hesan0308@gmail.com
          git config --global user.name hesan0308

      - name: Configure npm auth
        run: echo "//registry.npmjs.org/:_authToken=${NPM_TOKEN}" >> .npmrc
        env:
          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}

      - name: Install dependencies
        run: npm install

      - name: Bundle with esbuild
        # Re-bundle here so the published package has
        # the self-contained bin/hesanlint.js baked in.
        run: |
          npx esbuild src/cli.js \
            --bundle \
            --platform=node \
            --target=node18 \
            --format=esm \
            --outfile=bin/hesanlint.js

      - name: Release
        run: npx auto shipit
        env:
          GH_TOKEN: ${{ secrets.GH_TOKEN }}
          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}
