{
  "name": "hesanlint",
  "version": "0.1.0",
  "description": "Performance-first linter for React/Next.js — catches bundle killers ESLint misses",
  "type": "module",
  "bin": {
    "hesanlint": "./bin/hesanlint.js"
  },
  "main": "./src/runner.js",
  "exports": {
    ".": "./src/runner.js"
  },
  "files": [
    "bin",
    "src",
    ".hesanlintrc.json",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/cli.js --bundle --platform=node --target=node18 --format=esm --outfile=bin/hesanlint.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": [
    "eslint",
    "linter",
    "react",
    "nextjs",
    "performance",
    "bundle-size",
    "tailwind",
    "styled-components"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.9",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.0",
    "commander": "^12.0.0",
    "fast-glob": "^3.3.2",
    "madge": "^6.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jest": "^29.7.0"
  }
}
